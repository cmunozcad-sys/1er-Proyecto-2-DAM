		<type name="varchar" length="60"/>
	</column>
	<column name="categoria" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<column name="descripcion">
		<type name="varchar" length="300"/>
	</column>
	<column name="precio_base" not-null="true">
		<type name="numeric" length="10" precision="2"/>
	</column>
	<column name="personalizable" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<column name="imagen">
		<type name="varchar" length="100"/>
	</column>
	<column name="destacado" not-null="true" default-value="false">
		<type name="boolean" length="0"/>
	</column>
	<column name="activo" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="modelo_pk" type="pk-constr" table="public.modelo">
		<columns names="id_modelo" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_modelo_ref_odoo" type="uq-constr" table="public.modelo">
		<columns names="ref_odoo" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_modelo_nombre" type="uq-constr" table="public.modelo">
		<columns names="nombre" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_modelo_categoria" type="ck-constr" table="public.modelo">
			<expression><![CDATA[categoria IN ('correr', 'botas', 'futbol', 'baloncesto')]]></expression>
	</constraint>
	<constraint name="ck_modelo_precio" type="ck-constr" table="public.modelo">
			<expression><![CDATA[precio_base > 0]]></expression>
	</constraint>
</table>

<table name="variante" layers="0" collapse-mode="2" max-obj-count="6" z-value="0">
