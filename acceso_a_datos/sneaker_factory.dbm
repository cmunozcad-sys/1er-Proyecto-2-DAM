<table name="stock" layers="0" collapse-mode="2" max-obj-count="5" z-value="0">
	<schema name="public"/>
	<position x="1440" y="760"/>
	<column name="id_variante" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="talla" not-null="true">
		<type name="numeric" length="3" precision="1"/>
	</column>
	<column name="cantidad" not-null="true" default-value="0">
		<type name="integer" length="0"/>
	</column>
	<column name="stock_minimo" not-null="true" default-value="5">
		<type name="integer" length="0"/>
	</column>
	<column name="ultima_actualizacion" not-null="true" default-value="now()">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="stock_pk" type="pk-constr" table="public.stock">
		<columns names="id_variante,talla" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_stock_talla" type="ck-constr" table="public.stock">
			<expression><![CDATA[talla BETWEEN 30 AND 48]]></expression>
	</constraint>
	<constraint name="ck_stock_cantidad" type="ck-constr" table="public.stock">
			<expression><![CDATA[cantidad >= 0]]></expression>
	</constraint>
	<constraint name="ck_stock_minimo" type="ck-constr" table="public.stock">
			<expression><![CDATA[stock_minimo >= 0]]></expression>
	</constraint>
</table>

