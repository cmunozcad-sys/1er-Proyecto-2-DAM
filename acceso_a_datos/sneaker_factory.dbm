	</column>
	<constraint name="log_eventos_pk" type="pk-constr" table="public.log_eventos">
		<columns names="id_log" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_log_eventos_operacion" type="ck-constr" table="public.log_eventos">
			<expression><![CDATA[operacion IN ('INSERT', 'UPDATE', 'DELETE')]]></expression>
	</constraint>
</table>

<table name="cliente" layers="0" collapse-mode="2" max-obj-count="11" z-value="0">
	<schema name="public"/>
	<position x="520" y="60"/>
	<column name="id_cliente" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="ref_odoo" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<column name="nombre" not-null="true">
		<type name="varchar" length="100"/>
	</column>
	<column name="tipo" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<column name="cif">
		<type name="varchar" length="15"/>
	</column>
	<column name="email">
		<type name="varchar" length="120"/>
	</column>
	<column name="telefono">
		<type name="varchar" length="20"/>
	</column>
	<column name="direccion">
		<type name="varchar" length="150"/>
	</column>
	<column name="ciudad">
		<type name="varchar" length="60"/>
	</column>
	<column name="activo" not-null="true" default-value="true">
		<type name="boolean" length="0"/>
	</column>
	<column name="fecha_alta" not-null="true" default-value="CURRENT_DATE">
		<type name="date" length="0"/>
	</column>
	<constraint name="cliente_pk" type="pk-constr" table="public.cliente">
		<columns names="id_cliente" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_cliente_ref_odoo" type="uq-constr" table="public.cliente">
		<columns names="ref_odoo" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_cliente_cif" type="uq-constr" table="public.cliente">
		<columns names="cif" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_cliente_email" type="uq-constr" table="public.cliente">
		<columns names="email" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_cliente_tipo" type="ck-constr" table="public.cliente">
			<expression><![CDATA[tipo IN ('CLUB', 'EQUIPO', 'EMPRESA', 'PARTICULAR')]]></expression>
	</constraint>
</table>

<table name="pedido" layers="0" collapse-mode="2" max-obj-count="12" z-value="0">
	<schema name="public"/>
	<position x="520" y="520"/>
	<column name="id_pedido" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="ref_odoo" not-null="true">
		<type name="varchar" length="20"/>
	</column>
	<column name="tipo" not-null="true">
		<type name="varchar" length="10"/>
	</column>
	<column name="estado" not-null="true" default-value="'BORRADOR'">
		<type name="varchar" length="12"/>
	</column>
	<column name="fecha_pedido" not-null="true" default-value="now()">
		<type name="timestamp" length="0"/>
	</column>
	<column name="fecha_entrega_prevista">
		<type name="date" length="0"/>
	</column>
	<column name="fecha_confirmacion">
		<type name="timestamp" length="0"/>
	</column>
	<column name="fecha_cancelacion">
		<type name="timestamp" length="0"/>
	</column>
	<column name="total" not-null="true" default-value="0">
		<type name="numeric" length="12" precision="2"/>
	</column>
	<column name="observaciones">
		<type name="varchar" length="300"/>
	</column>
	<column name="id_cliente" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="id_usuario">
		<type name="integer" length="0"/>
	</column>
	<constraint name="pedido_pk" type="pk-constr" table="public.pedido">
		<columns names="id_pedido" ref-type="src-columns"/>
	</constraint>
	<constraint name="uq_pedido_ref_odoo" type="uq-constr" table="public.pedido">
		<columns names="ref_odoo" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_pedido_tipo" type="ck-constr" table="public.pedido">
			<expression><![CDATA[tipo IN ('ESTANDAR', 'CUSTOM')]]></expression>
	</constraint>
	<constraint name="ck_pedido_estado" type="ck-constr" table="public.pedido">
			<expression><![CDATA[estado IN ('BORRADOR', 'CONFIRMADO', 'CANCELADO')]]></expression>
	</constraint>
	<constraint name="ck_pedido_total" type="ck-constr" table="public.pedido">
			<expression><![CDATA[total >= 0]]></expression>
	</constraint>
	<constraint name="ck_pedido_entrega" type="ck-constr" table="public.pedido">
			<expression><![CDATA[fecha_entrega_prevista IS NULL OR fecha_entrega_prevista >= fecha_pedido::date]]></expression>
	</constraint>
</table>

<table name="linea_pedido" layers="0" collapse-mode="2" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<position x="980" y="520"/>
	<column name="id_linea" not-null="true">
		<type name="serial" length="0"/>
	</column>
	<column name="talla" not-null="true">
		<type name="numeric" length="3" precision="1"/>
	</column>
	<column name="cantidad" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="precio_unitario" not-null="true">
		<type name="numeric" length="10" precision="2"/>
	</column>
	<column name="personalizacion">
		<type name="varchar" length="200"/>
	</column>
	<column name="texto_bordado">
		<type name="varchar" length="40"/>
	</column>
	<column name="logo_club" not-null="true" default-value="false">
		<type name="boolean" length="0"/>
	</column>
	<column name="id_pedido" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="id_variante" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="linea_pedido_pk" type="pk-constr" table="public.linea_pedido">
		<columns names="id_linea" ref-type="src-columns"/>
	</constraint>
	<constraint name="ck_linea_pedido_cantidad" type="ck-constr" table="public.linea_pedido">
			<expression><![CDATA[cantidad > 0]]></expression>
	</constraint>
	<constraint name="ck_linea_pedido_precio" type="ck-constr" table="public.linea_pedido">
			<expression><![CDATA[precio_unitario >= 0]]></expression>
	</constraint>
</table>

<table name="modelo" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="public"/>
	<position x="1440" y="60"/>
	<column name="id_modelo" not-null="true">
