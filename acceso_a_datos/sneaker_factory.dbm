<table name="log_eventos" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
	<schema name="public"/>
	<position x="60" y="1060"/>
	<column name="id_log" not-null="true">
		<type name="bigserial" length="0"/>
	</column>
	<column name="fecha" not-null="true" default-value="clock_timestamp()">
		<type name="timestamp" length="0"/>
	</column>
	<column name="tabla" not-null="true">
		<type name="varchar" length="30"/>
	</column>
	<column name="operacion" not-null="true">
		<type name="varchar" length="10"/>
	</column>
	<column name="registro_id" not-null="true">
		<type name="integer" length="0"/>
	</column>
